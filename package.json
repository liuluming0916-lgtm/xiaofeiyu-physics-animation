{
  "name": "xfy-2.0",
  "version": "2.6.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "小肥鱼物理动画 2.6.6 · 自主 Agent + 物理沙盒闭环",
  "author": "小肥鱼物理动画项目组 <1241640869@qq.com>",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "app:dev": "node scripts/build-app.ts && electron .",
    "build:app": "node scripts/build-app.ts",
    "app:portable": "node scripts/build-app.ts && node scripts/pack-portable.ts",
    "app:build": "node scripts/build-app.ts && electron-builder --win",
    "web": "node apps/server/src/server.ts",
    "m0": "node scripts/m0-demo.ts",
    "run": "node scripts/run-problem.ts",
    "probe": "node scripts/probe-api.ts",
    "regress": "node scripts/regress.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.xiaofeiyu.physics-animation",
    "productName": "小肥鱼物理动画",
    "copyright": "小肥鱼物理动画项目组 · AGPL-3.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/app/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "COMMERCIAL.md",
      "TRADEMARK.md"
    ],
    "extraResources": [
      "LICENSE",
      "NOTICE",
      "COMMERCIAL.md",
      "TRADEMARK.md"
    ],
    "asar": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小肥鱼物理动画",
      "deleteAppDataOnUninstall": false
    }
  }
}
