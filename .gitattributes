# 默认：自动识别文本，仓库内统一 LF
* text=auto eol=lf

# 明确文本类型
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.jsx     text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf

# Windows 脚本保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不做换行/差异转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.zip     binary
*.7z      binary
*.gz      binary
