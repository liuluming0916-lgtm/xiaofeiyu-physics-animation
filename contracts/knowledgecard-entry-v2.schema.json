{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design.local/contracts/knowledgecard-entry-v2.schema.json",
  "title": "知识卡条目 v2（词表驱动）",
  "description": "v2 删除了 keys / secondary_keys / concepts / tags / category / insertion_slot / recursive。触发只来自词表：element 卡用 elements，scene 卡用 scenes，anim_rule 卡 constant。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "enabled", "origin", "content"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["anim_rule", "element", "scene"] },
    "enabled": { "type": "boolean" },
    "origin": { "enum": ["builtin", "user"] },
    "constant": { "type": "boolean", "default": false },
    "elements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "order": { "type": "integer", "default": 100 },
    "priority": { "enum": ["normal", "high"], "default": "normal" },
    "content": { "type": "string", "minLength": 1 },
    "code_examples": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "size": {
      "description": "B1'：外观尺寸（10×6 纸面单位，跨题一样大，渲染不乘 s）。只给 element 卡；场景卡不写（尺寸由模型按题决定）。board 的 w 可缺省（长度由模型给）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "shape"],
      "properties": {
        "anchor": { "enum": ["bottom", "center", "top"] },
        "shape": {
          "enum": ["box", "circle", "belt", "incline", "line", "point", "trace", "curve", "polygon", "spring"]
        },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "r": { "type": "number", "exclusiveMinimum": 0 },
        "pointR": { "type": "number", "minimum": 0 },
        "minPx": { "type": "number", "minimum": 0, "default": 0 },
        "rotatable": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "enum": ["box", "belt", "incline", "line"] } }, "required": ["shape"] },
          "then": { "required": ["w", "h"] }
        },
        {
          "if": { "properties": { "shape": { "const": "circle" } }, "required": ["shape"] },
          "then": { "required": ["r"] }
        }
      ]
    },
    "physical": {
      "description": "B1'：真实尺寸（物理米）。只给 element 卡，只用于 analysis 把质心放到支撑面上方；不参与渲染。至少要给 h 或 r。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "r": { "type": "number", "exclusiveMinimum": 0 }
      },
      "anyOf": [{ "required": ["h"] }, { "required": ["r"] }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "element" } }, "required": ["kind"] },
      "then": {
        "required": ["elements"],
        "properties": {
          "constant": { "const": false },
          "scenes": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "scene" } }, "required": ["kind"] },
      "then": {
        "required": ["scenes"],
        "properties": {
          "constant": { "const": false },
          "elements": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "anim_rule" } }, "required": ["kind"] },
      "then": {
        "required": ["constant"],
        "properties": {
          "constant": { "const": true },
          "elements": { "maxItems": 0 },
          "scenes": { "maxItems": 0 },
          "size": { "not": {} },
          "physical": { "not": {} }
        }
      }
    }
  ]
}
