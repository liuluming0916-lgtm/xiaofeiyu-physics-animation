{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design.local/contracts/knowledgecard-entry-v2.schema.json",
  "title": "知识卡条目 v2（词表驱动）",
  "description": "v2 删除了 keys / secondary_keys / concepts / tags / category / insertion_slot / recursive。触发只来自词表：element 卡用 elements，scene 卡用 scenes，anim_rule 卡 constant。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "enabled", "origin", "content"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["anim_rule", "element", "scene"] },
    "enabled": { "type": "boolean" },
    "origin": { "enum": ["builtin", "user"] },
    "constant": { "type": "boolean", "default": false },
    "elements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "order": { "type": "integer", "default": 100 },
    "priority": { "enum": ["normal", "high"], "default": "normal" },
    "content": { "type": "string", "minLength": 1 },
    "code_examples": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "size": {
      "description": "C 方案：只表达形状（教学用），不再存数字尺寸。尺寸唯一来源是 physical（物理米），渲染时乘舞台比例 s。只给 element 卡。",
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {
          "enum": ["box", "circle", "belt", "incline", "line", "point", "trace", "curve", "polygon", "spring"]
        },
        "rotatable": { "type": "boolean", "default": false }
      }
    },
    "physical": {
      "description": "C 方案：真实尺寸（物理米），是**唯一尺寸来源**。渲染时乘舞台比例 s；题面没给尺寸时用这张卡的默认值。至少要给 h 或 r；w 可缺省（板长等由模型按题面给）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "r": { "type": "number", "exclusiveMinimum": 0 }
      },
      "anyOf": [{ "required": ["h"] }, { "required": ["r"] }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "element" } }, "required": ["kind"] },
      "then": {
        "required": ["elements"],
        "properties": {
          "constant": { "const": false },
          "scenes": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "scene" } }, "required": ["kind"] },
      "then": {
        "required": ["scenes"],
        "properties": {
          "constant": { "const": false },
          "elements": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "anim_rule" } }, "required": ["kind"] },
      "then": {
        "required": ["constant"],
        "properties": {
          "constant": { "const": true },
          "elements": { "maxItems": 0 },
          "scenes": { "maxItems": 0 },
          "size": { "not": {} },
          "physical": { "not": {} }
        }
      }
    }
  ]
}
