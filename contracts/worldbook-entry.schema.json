{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design.local/contracts/worldbook-entry.schema.json",
  "title": "世界书词条（§9.1 字段冻结）",
  "description": "§9.1 词条模型。`insertion_slot` 元素只能是 solve | scene_code（= 目标阶段名）；`scene_spec` 是 v2 旧名，不得进入枚举，仅在导入路径归一化。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "词条 id，同库内不得重复"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "kind": {
      "$ref": "#/$defs/EntryKind"
    },
    "enabled": {
      "type": "boolean"
    },
    "constant": {
      "type": "boolean",
      "default": false,
      "description": "常驻：无条件注入"
    },
    "recursive": {
      "type": "boolean",
      "default": true,
      "description": "允许被级联唤醒 / 自身可唤醒别人"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "字符串=字面量包含；\"/…/\"=正则。正则非法须在保存时拒绝。"
      },
      "description": "主键；空数组时 constant 为真仍注入，否则仅可被递归唤醒"
    },
    "secondary_keys": {
      "$ref": "#/$defs/SecondaryKeys"
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConceptId"
      },
      "uniqueItems": true,
      "description": "考点（词表 A）；元素必须是 ConceptId 枚举内的 id。空/缺省 ⇒ 该词条不走概念分发"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TagName"
      },
      "uniqueItems": true,
      "description": "题型标签 / 细考点（词表 B）；每个 tag 必须属于本词条某个 concepts。空数组 = 该考点下的通用词条"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ElementId"
      },
      "uniqueItems": true,
      "description": "实体物理图元（动画元件，原名 devices/器材）；元素必须是 ElementId 枚举内的 id"
    },
    "insertion_slot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InsertionSlot"
      },
      "uniqueItems": true,
      "description": "空数组 [] 合法但标注\"未挂槽位\"；元素只能是 solve | scene_code"
    },
    "order": {
      "type": "integer",
      "description": "同槽位内排序，小在前；同 order 按 id 稳定排序",
      "default": 100
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "正文；双槽词条按 \"## 解题\" / \"## 动画建模\" 二级标题切分"
    },
    "code_examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "§9.5 用法示例（第 5 期接入引擎；字段形状本期冻结）"
    }
  },
  "required": [
    "id",
    "title",
    "origin",
    "category",
    "enabled",
    "keys",
    "insertion_slot",
    "content"
  ],
  "$defs": {
    "InsertionSlot": {
      "type": "string",
      "enum": [
        "solve",
        "scene_code"
      ],
      "title": "§9.1 世界书槽位名 = 目标阶段名"
    },
    "Origin": {
      "type": "string",
      "enum": [
        "builtin",
        "user"
      ]
    },
    "Category": {
      "type": "string",
      "enum": [
        "solution_skill",
        "scene_modeling",
        "both_slot",
        "user_lore"
      ]
    },
    "EntryKind": {
      "type": "string",
      "enum": [
        "anim_rule",
        "element",
        "scene"
      ],
      "title": "知识卡类型（只含 worldbook 条目：动画规范 / 元件 / 场景）",
      "description": "提示词卡与本地规则卡属于产品层知识卡，但不是 worldbook 条目，不走这个字段。缺省按 element 处理（兼容旧包）；类型只影响 UI 分组与注入顺序，不影响命中语义。"
    },
    "SecondaryLogic": {
      "type": "string",
      "enum": [
        "AND_ANY",
        "AND_ALL",
        "OR",
        "NOT"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ]
    },
    "SecondaryKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logic": {
          "$ref": "#/$defs/SecondaryLogic"
        },
        "list": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "次级键；空数组时 AND_ANY/AND_ALL/OR 直接通过，NOT 视为通过"
        }
      },
      "required": [
        "logic",
        "list"
      ],
      "title": "次级键逻辑"
    },
    "ConceptId": {
      "type": "string",
      "enum": [
        "uniform_acceleration",
        "motion_graphs",
        "free_fall_vertical",
        "pursuit_encounter",
        "relative_motion",
        "projectile_motion",
        "circular_motion",
        "force_analysis",
        "dynamic_equilibrium",
        "whole_isolate",
        "newton_laws",
        "dynamics_two_ways",
        "connected_bodies",
        "spring_force",
        "block_board",
        "conveyor_belt",
        "critical_cases",
        "gravitation",
        "artificial_satellite",
        "relativity",
        "work_power",
        "kinetic_energy_theorem",
        "mechanical_energy_conservation",
        "work_energy_relation",
        "variable_force_work",
        "momentum_theorem",
        "momentum_conservation",
        "collision",
        "man_boat_explosion",
        "simple_harmonic",
        "mechanical_wave",
        "refraction_total_reflection",
        "light_wave_nature",
        "electrostatics_field",
        "charge_in_electric_field",
        "capacitor",
        "dc_circuit",
        "closed_circuit",
        "magnetic_field_ampere",
        "lorentz_particle",
        "combined_fields",
        "induction_law",
        "induction_circuit_graph",
        "rod_energy",
        "ac_generation",
        "transformer_transmission",
        "em_wave",
        "molecular_theory",
        "gas_laws",
        "solids_liquids",
        "thermo_laws",
        "wave_particle_duality",
        "atomic_structure",
        "atomic_nucleus",
        "exp_mechanics",
        "exp_electricity",
        "exp_optics_thermal"
      ],
      "title": "考点词表（词表 A；派生自 contracts/worldbook-concepts.json）",
      "description": "解题侧一级触发源。判定：concepts 相交 且（tags 相交 或 tags 为空）。"
    },
    "TagName": {
      "type": "string",
      "enum": [],
      "title": "题型标签 / 细考点词表（词表 B；派生自同一份词表，按考点分组）",
      "description": "解题侧二级。**跨字段约束（Schema 表达不了，落在运行期）**：一条词条的每个 tag 必须属于该词条某个 concepts；`tags` 为空 = 该考点下的通用词条（方案 b 兜底）。"
    },
    "ElementId": {
      "type": "string",
      "enum": [
        "block",
        "board",
        "incline",
        "ball",
        "arc_track",
        "ground",
        "spring",
        "pulley",
        "rope",
        "rod",
        "stand",
        "belt",
        "circuit",
        "plates",
        "ray",
        "lens",
        "field_region",
        "vector",
        "trace_path",
        "paper_tape",
        "ghosts",
        "axis_box",
        "chart",
        "graph_wave",
        "orbit",
        "cylinder_piston",
        "gas_tube",
        "light_spot",
        "measuring_tool",
        "raw_composite"
      ],
      "title": "实体物理图元 · 动画元件词表（派生自同一份词表；原名 devices / 器材）",
      "description": "动画侧触发源。命中 = 词条 elements ∩ 模型报的动画元件 ≠ ∅，再用考点收窄。判定细则（用户裁决 A25）：矢量箭头**算**；尺寸标注、文字标注**不算**。"
    }
  },
  "x-od-contract": {
    "id": "worldbook-entry",
    "rootType": "WorldbookEntry",
    "generatedFrom": "contracts/spec/contract-fields.mjs",
    "frozenBy": "物理解题动画软件 v1.0 自研方案 §3 / §9 / §11.1 / §12"
  }
}
